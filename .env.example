# Entorno
NODE_ENV=development
PORT=4000

# Seguridad
# En produccion debe tener minimo 32 caracteres y no debe subirse nunca el .env real.
AUTH_SECRET=change_me_with_a_long_random_secret_min_32_chars

# SQLite
# Local
DB_PATH=./data/ceos.sqlite

# Render ejemplo:
# DB_PATH=/var/data/ceos.sqlite

# Railway ejemplo:
# DB_PATH=/app/data/ceos.sqlite

# URLs publicas / CORS
PUBLIC_APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://127.0.0.1:5173

# Demo privada
# Activar solo en entornos de demo controlada, nunca en produccion cliente.
VITE_PUBLIC_DEMO_MODE=false
VITE_ENABLE_MA_LOCAL_FALLBACK=false

# Bootstrap opcional para e2e/demo privada
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change_me_with_a_private_password
# BOOTSTRAP_ORGANIZATION_ID=org_private_demo
# BOOTSTRAP_USERS_JSON=[]
