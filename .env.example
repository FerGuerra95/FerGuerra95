# Entorno
NODE_ENV=development
PORT=4000

# Seguridad
# En produccion debe tener minimo 32 caracteres y no debe subirse nunca el .env real.
AUTH_SECRET=change_me_with_a_long_random_secret_min_32_chars

# SQLite
# Local
DB_PATH=./data/ceos.sqlite

# Render ejemplo:
# DB_PATH=/var/data/ceos.sqlite

# Railway ejemplo:
# DB_PATH=/app/data/ceos.sqlite

# URLs publicas / CORS
PUBLIC_APP_URL=http://localhost:4000
# URL del SPA (enlaces de recuperacion de contraseña y redirect SSO). En dev con Vite suele ser el puerto 5173.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://127.0.0.1:5173

# Secure share M&A (enlaces con token en el fragmento del SPA)
# - El visor es la ruta pública /ma/secure-share#sid=...&t=... (no exige login).
# - La API pública es GET /api/ma/public/secure-shares/:id con cabecera X-MA-Share-Token
#   (rate limit por IP+id del enlace). La variante autenticada GET /api/ma/secure-shares/:id
#   sigue existiendo para usuarios con sesión en la organización correcta.
# Staging: no expongas datos sensibles en FRONTEND_URL/PUBLIC_APP_URL abiertos a Internet
# si además activas demo o credenciales débiles; trata los enlaces secure share como secretos.

# Opcional: forzar re-sync de usuarios bootstrap desde .env (pisa contraseñas en DB)
# BOOTSTRAP_SYNC_USERS=true

# SMTP (opcional). Si SMTP_HOST y EMAIL_FROM están definidos, se envían correos de recuperación.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Redis (opcional). Estado OIDC entre réplicas y rate limit /api; sin REDIS_URL todo queda en memoria del proceso.
# REDIS_URL=redis://127.0.0.1:6379

# CSP: orígenes extra permitidos en connect-src (lista separada por comas).
# CSP_EXTRA_CONNECT_SRC=https://api.example.com

# OIDC / SSO (opcional). Sin OIDC_ISSUER + OIDC_CLIENT_ID el boton SSO devolvera 503.
# C.14.6: id_token se verifica por firma (JWKS RS256 o HS256+CLIENT_SECRET). Sin jwks_uri en discovery
# el login OIDC fallara si userinfo no devuelve email. No desactivar verificacion.
# OIDC_ISSUER=https://tu-proveedor.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# URL publica del API para armar redirect_uri (produccion / tunel)
# OIDC_PUBLIC_URL=http://localhost:4000
# OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# Restringe SSO a un dominio de email corporativo (sin @ o con @)
# OIDC_ALLOWED_EMAIL_DOMAIN=empresa.com
# Provision JIT al primer login OIDC
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ORG_ID=
# OIDC_DEFAULT_ROLE=user
# OIDC_PKCE=false desactiva PKCE si un IdP legacy no lo soporta (por defecto activo).

# Contraseñas nuevas (reset): longitud mínima y complejidad (tres de cuatro categorías).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_SKIP_COMPLEXITY=true

# Logs HTTP JSON por petición (requestId, método, ruta, status, ms). Desactivado por defecto.
# LOG_HTTP=1

# Demo privada
VITE_PUBLIC_DEMO_MODE=false
VITE_ENABLE_MA_LOCAL_FALLBACK=false

# Playwright (local): tras npm ci instala Chromium con `npm run playwright:install`
# CEOS_E2E_USER / CEOS_E2E_PASSWORD si no usas el admin por defecto del bootstrap

# Bootstrap opcional para e2e/demo privada
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change_me_with_a_private_password
# BOOTSTRAP_ORGANIZATION_ID=org_private_demo
# BOOTSTRAP_USERS_JSON=[]
