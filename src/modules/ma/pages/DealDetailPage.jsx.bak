export function DealDetailPage() {
  const { dealId } = useParams();
  const navigate = useNavigate();
  const { financials, settings, savedCases } = useMAStore();

  const derived = useValuationEngine({
    financials,
    settings
  });

  const reportCurrency = settings?.reportCurrency || financials?.currency || 'EUR';
  const safeSavedCases = Array.isArray(savedCases) ? savedCases : [];

  const deal = useMemo(
    () =>
      resolveDealDetail({
        dealId,
        financials,
        settings,
        derived,
        savedCases: safeSavedCases,
        currency: reportCurrency
      }),
    [dealId, financials, settings, derived, safeSavedCases, reportCurrency]
  );

  if (!deal) {
    return (
      <div className="page">
        <style>{dealDetailCss}</style>

        <div className="ma-deal-detail-page">
          <section className="ma-detail-empty">
            <div className="ma-detail-kicker">
              <AlertTriangle size={14} />
              Deal not found
            </div>

            <h2>No se ha encontrado esta operación</h2>

            <p className="muted">
              Puede que el caso no exista todavía, que el identificador haya
              cambiado o que el deal no esté guardado en el repositorio.
            </p>

            <div className="ma-deal-detail-actions" style={{ justifyContent: 'center' }}>
              <Button variant="secondary" onClick={() => navigate(-1)}>
                <ArrowLeft size={16} />
                Volver
              </Button>

              <Link to="/ma/pipeline">
                <Button>
                  <Layers3 size={16} />
                  Abrir Deal Pipeline
                </Button>
              </Link>
            </div>
          </section>
        </div>
      </div>
    );
  }

  return (
    <div className="page">
      <style>{dealDetailCss}</style>

      <div className="ma-deal-detail-page">
        <section className="ma-deal-detail-hero">
          <div className="ma-deal-detail-hero-inner">
            <div>
              <div className="ma-deal-detail-badges">
                <Badge>M&A Deal Detail</Badge>
                <Badge>{resolvedDeal.sourceLabel}</Badge>
                <Badge>{resolvedDeal.stageLabel}</Badge>
                <Badge>{resolvedDeal.priority}</Badge>
              </div>

              <h1 className="ma-deal-detail-title">
                {resolvedDeal.name}
                <span>Single deal intelligence file.</span>
              </h1>

              <p className="ma-deal-detail-copy">
                Ficha ejecutiva de operación con valoraciÃ³n, fase, prioridad,
                riesgo, tesis, documentaciÃ³n pendiente y disciplina de siguiente
                paso. DiseÃ±ada como base para una versiÃ³n multinacional con
                deal detail, IC memo, data room y audit trail.
              </p>

              <div className="ma-deal-detail-actions">
                <Link to="/ma/pipeline">
                  <Button>
                    <Layers3 size={16} />
                    Volver al pipeline
                  </Button>
                </Link>

                <Link to="/ma/valuation">
                  <Button variant="secondary">
                    <BarChart3 size={16} />
                    Valuation Engine
                  </Button>
                </Link>

                <Link to="/ma/cim">
                  <Button variant="secondary">
                    <FileText size={16} />
                    Preparar report
                  </Button>
                </Link>
              </div>

              <div className="ma-deal-detail-command-bar">
                <CommandItem label="Stage" value={resolvedDeal.stageLabel} />
                <CommandItem label="Owner" value={resolvedDeal.owner} />
                <CommandItem label="Updated" value={resolvedDeal.updatedLabel} />
              </div>
            </div>

            <aside className="ma-deal-detail-status-card">
              <div className="ma-deal-detail-status-inner">
                <div className="ma-deal-detail-status-top">
                  <div>
                    <div className="kpi-label">Deal Signal</div>
                    <div className="ma-deal-detail-status-title">
                      {resolvedDeal.signalTitle}
                    </div>
                  </div>

                  <div className="ma-deal-detail-icon-box">
                    <Sparkles size={21} />
                  </div>
                </div>

                <div className="ma-deal-detail-status-box">
                  <strong>{resolvedDeal.recommendedAction}</strong>

                  <p className="muted">
                    RevisiÃ³n generada desde los datos actuales del caso. Antes de
                    circular conclusiones, valida documentaciÃ³n financiera,
                    deuda, caja, working capital, concentraciÃ³n y soporte legal.
                  </p>
                </div>

                <CommandItem label="Risk" value={resolvedDeal.riskLabel} />
                <CommandItem label="Quality score" value={resolvedDeal.qualityScoreLabel} />
              </div>
            </aside>
          </div>
        </section>

        <section className="ma-deal-detail-grid">
          <section className="ma-detail-panel">
            <PanelHeader
              kicker="Valuation snapshot"
              icon={TrendingUp}
              title="Deal economics"
              description="Resumen econÃ³mico principal de la operación."
            />

            <div className="ma-detail-metric-grid">
              <Metric label="Equity Value" value={resolvedDeal.equityLabel} />
              <Metric label="Enterprise Value" value={resolvedDeal.enterpriseLabel} />
              <Metric label="EBITDA normalizado" value={resolvedDeal.ebitdaLabel} />
